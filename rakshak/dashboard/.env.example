# =============================================================================
# RAKSHAK dashboard — build/runtime environment
# Copy to .env for local `npm run dev`. Docker builds pass VITE_API_URL as a
# build argument (see docker-compose.yml), so no file is required in Docker.
# =============================================================================

# Base URL for REST and WebSocket traffic. Relative values are proxied by Vite
# (dev) or nginx (production image); absolute values such as
# http://localhost:8000/api/v1 connect straight to the backend.
VITE_API_URL=/api/v1

# Upstream used by the Vite dev-server proxy for /api and /ws.
# Inside docker-compose this is the backend service name.
VITE_PROXY_TARGET=http://backend:8000
