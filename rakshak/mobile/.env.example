# =============================================================================
# RAKSHAK mobile — Expo environment
# Copy to .env (Expo loads it automatically) before `npm start`.
# Expo inlines EXPO_PUBLIC_* variables into the JavaScript bundle at build time.
# =============================================================================

# Base URL of the RAKSHAK backend reachable from the device.
# Use your machine's LAN address for a physical device, 10.0.2.2 for an
# Android emulator, or a tunnel/hosted URL for a shared deployment.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
