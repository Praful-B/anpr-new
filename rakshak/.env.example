# =============================================================================
# RAKSHAK — Environment Variables
# Copy to .env and adjust values before running docker-compose.
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres          # Database username
POSTGRES_PASSWORD=postgres      # Database password
POSTGRES_DB=rakshak             # Database name

# --- Application ---
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/rakshak  # SQLAlchemy DSN (use host "postgres" inside Docker)
REDIS_URL=redis://redis:6379/0                                      # Redis connection string

# --- Encryption ---
# Base64-encoded 32-byte master key used to derive per-device HKDF keys.
# Generate your own and paste it here. NEVER commit a real key:
#   (see the command shown below)
#   python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
MASTER_KEY_B64=REPLACE_ME_with_32_byte_base64_key

# --- JWT ---
JWT_SECRET=REPLACE_ME_with_32_byte_base64_key
JWT_ALGORITHM=HS256             # HMAC algorithm for JWT signing
JWT_ACCESS_TTL_MIN=15           # Access token lifetime in minutes
JWT_REFRESH_TTL_DAYS=7          # Refresh token lifetime in days

# --- Security ---
BCRYPT_COST=12                  # Bcrypt hashing cost factor

# --- CORS ---
CORS_ORIGIN=http://localhost:5173  # Dashboard origin for CORS

# --- Storage ---
STORAGE_BACKEND=local           # Photo storage backend: "local" or "s3"
UPLOAD_DIR=./data/uploads       # Filesystem path for local photo storage

# --- Scheduling ---
FIR_DEADLINE_HOURS=48           # Hours after complaint approval before FIR expires
COOLDOWN_DAYS=7                 # Days after expiry before a plate can be re-listed

# --- Device simulator (host-side script) ---
# Default --backend value for scripts/device_simulator.py
RAKSHAK_BACKEND_URL=http://localhost:8000
